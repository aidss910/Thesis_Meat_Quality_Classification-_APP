#include <Wire.h>
#include <SPI.h>
#include "bsec.h"
#include "DFRobot_ADS1115.h"
#include "AMS_OSRAM_AS7343.h"
#include <esp_task_wdt.h>

#define BME68X_CS 5
#define LED_BUILTIN 2
#define ADS1115_I2C_ADDRESS 0x49
#define AS7343_I2C_ADDRESS 0x39
#define WDT_TIMEOUT 10

#define RXD2 16  // Connected to Arduino TX
#define TXD2 17

Bsec iaqSensor;
DFRobot_ADS1115 ads(&Wire);
AMS_OSRAM_AS7343 as7343;

const int sensorCount = 3;
bool collectingData = false;

bool tryInitSensor(bool (*initFunc)(), const char* sensorName, int retries = 5, int delayMs = 2000);

void setup() {
    Serial.begin(115200);  // Debugging to PC
    Serial2.begin(9600, SERIAL_8N1, RXD2, TXD2);
    Serial.println("ESP32 ready...");

    pinMode(LED_BUILTIN, OUTPUT);
    Wire.begin(21, 22);
    SPI.begin();

    esp_task_wdt_init(WDT_TIMEOUT, true);
    esp_task_wdt_add(NULL);

    if (!tryInitSensor(initBME680, "BME680")) return;
    if (!tryInitSensor(initADS1115, "ADS1115")) return;
    if (!tryInitSensor(initAS7343, "AS7343")) return;

    Serial.println("Waiting for serial toggle command...");
}

void loop() {
    static unsigned long lastReadTime = 0;
    static unsigned long lastBlink = 0;
    static bool lastCollecting = false;

    if (Serial2.available()) {
        String data = Serial2.readStringUntil('\n');
        data.trim();
        Serial.println("Received: " + data);
        if (data == "1") {
            collectingData = true;
        } else if (data == "0") {
            collectingData = false;
        }
    }

    if (collectingData != lastCollecting) {
        digitalWrite(LED_BUILTIN, collectingData ? HIGH : LOW);
        Serial.println(collectingData ? "1" : "0");
        if (collectingData) {
            Serial.println("VOC,V_H2S,V_NH3,V_VOC,Ch475nm,Ch555nm,Temp,Hum");
        }
        lastCollecting = collectingData;
    }

    if (collectingData && millis() - lastReadTime >= 3000) {
        lastReadTime = millis();
        collectAndSendData();
    }

    if (!collectingData && millis() - lastBlink >= 1000) {
        digitalWrite(LED_BUILTIN, !digitalRead(LED_BUILTIN)); // Blink LED
        lastBlink = millis();
    }

    esp_task_wdt_reset();
}



bool tryInitSensor(bool (*initFunc)(), const char* sensorName, int retries, int delayMs) {
    for (int i = 0; i < retries; i++) {
        if (initFunc()) return true;
        Serial.printf("Retrying %s initialization... (%d/%d)\n", sensorName, i + 1, retries);
        delay(delayMs);
    }
    Serial.printf("ERROR: %s failed to initialize!\n", sensorName);
    return false;
}

void collectAndSendData() {
    float temperature = -1.0, humidity = -1.0, voc = -1.0;
    float voltage[sensorCount] = { -1.0, -1.0, -1.0 };
    uint16_t ch_475nm = 0, ch_555nm = 0;

    readBME680(temperature, humidity, voc);
    readGasSensors(voltage);
    readSpectrometer(ch_475nm, ch_555nm);

    Serial.printf("%.3f,%.3f,%.3f,%.3f,%d,%d,%.3f,%.3f\n", 
                  voc, voltage[0], voltage[1], voltage[2], ch_475nm, ch_555nm, temperature, humidity);
}

bool initBME680() {
    iaqSensor.begin(BME68X_CS, SPI);
    bsec_virtual_sensor_t sensorList[] = {
        BSEC_OUTPUT_RAW_TEMPERATURE,
        BSEC_OUTPUT_RAW_HUMIDITY,
        BSEC_OUTPUT_BREATH_VOC_EQUIVALENT
    };
    iaqSensor.updateSubscription(sensorList, 3, BSEC_SAMPLE_RATE_LP);
    delay(2000);
    return iaqSensor.run();
}

void readBME680(float &temperature, float &humidity, float &voc) {
    if (iaqSensor.run()) {
        temperature = iaqSensor.rawTemperature;
        humidity = iaqSensor.rawHumidity;
        voc = iaqSensor.breathVocEquivalent;
    } else {
        temperature = humidity = voc = -1.0;
    }
}

bool initADS1115() {
    ads.setAddr_ADS1115(ADS1115_I2C_ADDRESS);
    ads.init();
    if (!ads.checkADS1115()) return false;
    ads.setGain(eGAIN_ONE);
    ads.setMode(eMODE_SINGLE);
    ads.setRate(eRATE_64);
    return true;
}

void readGasSensors(float voltage[]) {
    const float gainVoltage = 4.096;

    for (int i = 0; i < sensorCount; i++) {
        int16_t rawADC = ads.readVoltage(i);
        voltage[i] = (rawADC * gainVoltage) / 32768.0;
    }
}

bool initAS7343() {
    if (!as7343.begin(AS7343_I2C_ADDRESS)) return false;
    as7343.setATIME(600);
    as7343.setASTEP(999);
    as7343.setGain(AS7343_GAIN_512X);
    as7343.enableLED(true);
    return true;
}

void readSpectrometer(uint16_t &ch_475nm, uint16_t &ch_555nm) {
    as7343.clearDigitalSaturationStatus();
    as7343.clearAnalogSaturationStatus();

    if (!as7343.readAllChannels()) {
        Serial.println("ERROR: AS7343 failed to read channels!");
        ch_475nm = 0;
        ch_555nm = 0;
        return;
    }

    ch_475nm = (uint16_t)max(0.0f, as7343.getChannel(AS7343_CHANNEL_475_F3) * 0.125f);
    ch_555nm = (uint16_t)max(0.0f, as7343.getChannel(AS7343_CHANNEL_555_FY) * 0.25f);
}
